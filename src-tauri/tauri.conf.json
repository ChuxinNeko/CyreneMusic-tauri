{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CyreneMusicNext",
  "version": "0.4.6",
  "identifier": "com.cyrenemusic.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3456",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../out"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Cyrene Music Next",
        "width": 1280,
        "height": 820,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}