{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cyrene_music_tauri",
  "version": "0.1.0",
  "identifier": "com.cyrenemusic.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3456",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "cyrene_music_tauri",
        "width": 1280,
        "height": 820,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}